# Required
GROQ_API_KEY=your_groq_api_key_here

# Current Groq production model suitable for open-weight generation.
# Change this if Groq changes its supported model list.
GROQ_MODEL=openai/gpt-oss-120b

# Open-source embedding model downloaded by Sentence Transformers.
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# RAG settings
CHUNK_SIZE=900
CHUNK_OVERLAP=120
RETRIEVAL_TOP_K=8

# MCQ settings
MAX_QUESTIONS=100
GENERATION_BATCH_SIZE=10

# Validation/display
MIN_DOCUMENT_CHARS=500
MIN_CONTEXT_CHARS=500
SHOW_SOURCES=true
